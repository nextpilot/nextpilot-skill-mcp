// Markdown 规则的唯一事实源。**必须放在仓库根**。
//
// markdownlint-cli2 的优势：
//   1. CI 和 VS Code 扩展都能读到同一份配置（扩展优先读 .markdownlint-cli2.jsonc）
//   2. ignores 直接写在配置里，不再需要单独的 .markdownlintignore 文件
//      （markdownlint-cli 的 .markdownlintignore 扩展根本不读，是已知缺口）
{
  "config": {
    "default": true,
    // 行长：文档里表格和长 URL 折不断，按默认 80 会命中 1305 处。
    // 排版宽度由 prettier 管（.prettierrc 对 *.md 是 printWidth 120 + proseWrap preserve）。
    "MD013": false,
    // 内联 HTML：文档里有 <br>、<img>、<details> 等，属有意使用。
    "MD033": false,
    // 代码块语言标注：部分片段无对应语言。
    "MD040": false,
    // 裸 URL：正文里直接写链接地址。
    "MD034": false,
    // 首行必须是 H1：部分文件以 front matter 或说明块开头。
    "MD041": false,
    // 重复标题：同名小节（如"背景""结论"）在长文档里多处出现。
    "MD024": false,
    // 强调当标题：有用加粗段落充当小节的写法。
    "MD036": false,
    // 代码块风格：fence 与混排并存。
    "MD046": false,
    // 强调风格：* 与 _ 混用。
    "MD049": false,
    // 链接片段：部分锚点指向动态生成的标题。
    "MD051": false,
    "MD025": {
      "front_matter_title": "^\\s*title\\s*[:=]",
    },
  },
  // 这里是 **glob 表达式**，不是 gitignore 文件语法。
  // 实测（2026-09-23）：cli2 认 "web/content/skills/" 这种**带尾斜杠的目录**写法 ——
  // 删掉那两行后扫描文件数从 64 涨到 92（正好 +24 个 skills + 4 个 mcp），证明确实生效。
  // 别照 gitignore 习惯去"修正"它，也别假定同样的写法在别的工具里也成立。
  "ignores": [
    // 依赖与构建产物
    "**/node_modules/**",
    "**/.next/**",
    "web/test-results/**",
    // 本地类型检查用的虚拟环境（pyright 靠它找 numpy / pyulog）。site-packages 里带
    // 第三方 LICENSE.md，扫进来会报一堆与本项目无关的规则错。gitignore 管不到这里——
    // cli2 只读自己的 ignores。
    ".venv/",
    // 自动生成文件
    "web/content/guide/rule-*.mdx",
    "web/content/skills/",
    "web/content/mcp/",
    // 带 generated 标记的生成文件
    "**/*.generated.*",
    // AI 工具自动生成
    ".workbuddy/",
    ".claude/",
    ".cache/",
  ],
  // 刻意**不**整目录排除 knowledge/px4/meta/：里面那个 README 是手写的设计说明
  // （它开头写"生成物，一 tag 一份"是在介绍目录用途，不是说它自己被生成），该被 lint。
  // 真正生成的 <tag>.json 不在 **/*.md 的扫描范围里，本来就扫不到。
}
