# =============================================================================
# NextPilot Skill — 环境变量模板
# =============================================================================
# 使用方式：
#   1. 复制为 web/.env（本地开发）
#   2. 或填入 EdgeOne 控制台 → 项目 → 环境变量（线上部署）
#
# 生成随机密钥：openssl rand -base64 32
# 生成随机 hex  ：openssl rand -hex 24
#
# 优先级：EdgeOne 控制台 > .env 文件 > 代码默认值
#
# 标记说明：
#   🔴 必需     = 不填功能直接不可用或报错
#   🟡 有默认值  = 不填用代码兜底，填了覆盖
#   🟢 可选     = 不填对应功能降级/关闭，不报错
#
# 命名约定：
#   无前缀（AUTH_ / SMTP_ / DEEPSEEK_ / ISSUE_） = 仅服务端，浏览器不可读
#   NEXT_PUBLIC_ 开头                              = 浏览器可读，会内联到 JS bundle
# =============================================================================


# =============================================================================
# 1. 认证（🔴 必需）
# =============================================================================

# 会话加密密钥（任意 32+ 字符随机串，Node 与 Edge 必须一致）
AUTH_SESSION_SECRET=

# GitHub OAuth（https://github.com/settings/developers）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Gitee API 令牌（自动提交 Issue / 读取仓库信息等）
AUTH_GITEE_TOKEN=

# Node ↔ Edge 内部通信密钥（任意 48 字符随机串）
AUTH_EDGE_SECRET=

# 管理员邮箱白名单，逗号分隔，大小写不敏感
AUTH_ADMIN_EMAILS=


# =============================================================================
# 2. 邮箱验证码（🔴 必需）
# =============================================================================
# 默认值适配 QQ 邮箱 SMTP，其他邮箱请自行修改。
# 密码填的是 SMTP 授权码，不是邮箱登录密码。

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# =============================================================================
# 3. AI 解释（🔴 必需）
# =============================================================================

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 本地联调时设为 1，用模板报告替代真实 API 调用（🟢 可选）
LLM_MOCK=


# =============================================================================
# 4. 站点信息（🟡 有默认值）
# =============================================================================

# -- 基础品牌 --------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://skill.nextpilot.org
NEXT_PUBLIC_SITE_NAME=NextPilot Skill
NEXT_PUBLIC_SITE_SHORT=NextPilot
NEXT_PUBLIC_SITE_AUTHOR=NextPilot
NEXT_PUBLIC_SITE_DESCRIPTION=围绕感知 → 决策 → 控制 → 工具链的飞控 AI Skill 和 MCP 社区，内置 PX4 / ArduPilot 确定性日志分析服务。
NEXT_PUBLIC_SITE_KEYWORDS=飞控,flight control,AI skill,MCP,PX4,ArduPilot,日志分析,log analysis,无人机,UAV,NextPilot
NEXT_PUBLIC_OG_IMAGE=/opengraph-image

# -- SEO 验证 --------------------------------------------------
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_BAIDU_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_BAIDU_STAT_ID=

# -- 社交链接 --------------------------------------------------
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/nextpilot/nextpilot-skill-mcp
NEXT_PUBLIC_SOCIAL_GITEE=https://gitee.com/nextpilot/nextpilot-skill-mcp
NEXT_PUBLIC_SOCIAL_TWITTER=

# -- 页脚 ------------------------------------------------------
NEXT_PUBLIC_FOOTER_COPYRIGHT=NextPilot Skill · 让无人机更智能，让数据开口说话
NEXT_PUBLIC_FOOTER_TAGLINE=
NEXT_PUBLIC_REPO_URL=https://gitee.com/nextpilot/nextpilot-skill-mcp
NEXT_PUBLIC_ICP_NUMBER=


# =============================================================================
# 5. 自动上报 Issue（🟢 可选）
# =============================================================================
# ISSUE_ENABLED 不填 = 整个上报层 no-op，不报错

ISSUE_ENABLED=
ISSUE_PROVIDER=gitee
ISSUE_REPO=
ISSUE_LABELS=auto-report,bug
ISSUE_DEBUG=


# =============================================================================
# 6. 版本信息（🟢 可选）
# =============================================================================
# 由 next.config.ts 在构建期自动注入，一般无需手动填写

NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_COMMIT=
NEXT_PUBLIC_APP_COMMIT_DATE=


# =============================================================================
# 7. 天地图底图（🟢 可选）
# =============================================================================
# 不填 = 报告页底图下拉不出现"天地图"选项
# 申请：lbs.tianditu.gov.cn/server/MapService.html（服务类型选"地图服务"）

NEXT_PUBLIC_TIANDITU_TK=


# =============================================================================
# 8. Pyodide 自托管（🟢 可选）
# =============================================================================
# 不填 = 走公网 CDN（国外较慢），填了 = 从自托管地址加载

NEXT_PUBLIC_PYODIDE_URL=
NEXT_PUBLIC_PYULOG_WHEEL=


# =============================================================================
# 附：KV 绑定（非环境变量，在 EdgeOne 控制台单独配置）
# =============================================================================
# EdgeOne 控制台 → KV 存储 → 创建 namespace（nextpilot_main）
# 项目设置 → 绑定 KV，变量名填：NEXTPILOT_KV