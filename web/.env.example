# 冲刺 2 环境变量模板。复制为 .env（本地）或填入 EdgeOne 控制台 → 项目 → 环境变量（线上）。
# 生成密钥：openssl rand -base64 32 / openssl rand -hex 24

# ---- 认证（next-auth v5）----
# 任意 32+ 字符随机串；边缘函数用同一值解密会话 cookie，Node 与 Edge 必须一致
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 公网源站（Node 侧 SSR 同源调用 /internal/* 边缘函数时用；本地 edgeone pages dev 可不填）
SITE_URL=https://skill.nextpilot.org
# Node 侧与 /functions/internal/* 之间的共享密钥（任意 48 字符随机串）
AUTH_INTERNAL_SECRET=

# ---- 邮箱验证码发信（QQ/163 个人 SMTP，用授权码不是登录密码）----
# QQ：smtp.qq.com 465；163：smtp.163.com 465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- DeepSeek（边缘函数 /functions/api/explain.js 读取）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 线上报错自动提 issue（可选；不填 ISSUE_ENABLED 则整个上报层是 no-op）----
# token 只在边缘函数使用，浏览器只 POST 到自家 /api/report-error，永不接触 token。
ISSUE_ENABLED=
# gitee（默认）| github
ISSUE_PROVIDER=gitee
# owner/repo，如 nextpilot/nextpilot-skill-mcp
ISSUE_REPO=
# Gitee：设置 → 私人令牌，勾选 issues 权限
# GitHub：fine-grained PAT，只给目标仓库 issues:write（不要给 repo 全权）
ISSUE_TOKEN=
# 可选，逗号分隔
ISSUE_LABELS=auto-report,bug
# 置 1 后：/issue-probe?write=1 可做真实写入自检，/api/report-error 会回显上报结果
ISSUE_DEBUG=
# 可选：客户端上报附带的版本号，便于区分是哪次发版出的问题
NEXT_PUBLIC_APP_VERSION=

# ---- KV ----
# 在 EdgeOne 控制台开通 KV、创建 namespace（nextpilot_main）并绑定到项目，
# 绑定变量名必须为 NEXTPILOT_KV（不是环境变量，是 KV 命名空间绑定）。

# ---- 天地图底图（可选；不填则报告页底图下拉里不出现"天地图"这一项）----
# 到 lbs.tianditu.gov.cn/server/MapService.html 按说明申请 Key（服务类型选"地图服务"）。
# 天地图 WMTS 没有 tk 时瓦片直接 403；它只覆盖国内，境外飞行用 Esri。
NEXT_PUBLIC_TIANDITU_TK=

# ---- 端侧解析运行时（可选；不填则走公网 CDN）----
# Pyodide 运行时目录（要含 pyodide.js / pyodide.asm.wasm / python_stdlib.zip / pyodide-lock.json）；
# 自托管到 EdgeOne Blob 后国内快且稳：NEXT_PUBLIC_PYODIDE_URL=https://<blob域名>/pyodide/v0.27.7/full/
NEXT_PUBLIC_PYODIDE_URL=
# pyulog 的 wheel 直链（给了就跳过 PyPI 索引查询，只下载一次）：
# NEXT_PUBLIC_PYULOG_WHEEL=https://<blob域名>/wheels/pyulog-1.1.2-py3-none-any.whl
NEXT_PUBLIC_PYULOG_WHEEL=
