{
    "tabWidth": 4,
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "endOfLine": "auto",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc"],
            "options": { "tabWidth": 2 }
        },
        {
            "files": "*.md",
            "options": { "tabWidth": 2, "proseWrap": "preserve" }
        },
        {
            "files": "*.yml",
            "options": { "tabWidth": 2 }
        }
    ]
}
