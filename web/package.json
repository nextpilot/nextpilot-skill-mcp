{
  "name": "nextpilot-skill-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "sync:watch": "node scripts/sync-content.mjs --watch",
    "kb:watch": "node scripts/build-knowledge.mjs --watch",
    "check:skills": "node scripts/check-skill-spec.mjs",
    "check:mcp": "node scripts/check-mcp-spec.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:no-watch": "node scripts/sync-content.mjs && node scripts/build-knowledge.mjs && next dev",
    "build:kb": "node scripts/sync-content.mjs && node scripts/build-knowledge.mjs",
    "build": "node scripts/sync-content.mjs && node scripts/build-knowledge.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "fix:links": "node scripts/fix-node-links.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep '@smoke'",
    "test:e2e:full": "playwright test",
    "test:e2e:analyze": "playwright test --grep '日志分析流程'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.5",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.0.9",
    "plotly.js-basic-dist-min": "^4.1.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.9.8",
    "pyright": "^1.1.400",
    "typescript": "^7.0.2"
  }
}
