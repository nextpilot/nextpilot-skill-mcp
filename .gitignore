# 依赖与构建产物（各子项目）
node_modules/
.next/
out/
dist/
# 仓库根是零依赖的纯转发壳；根目录的 pnpm-lock.yaml 是空壳，不应入库
# （web/ 下的 pnpm-lock.yaml 是真实依赖锁，照常跟踪——前导 / 只匹配仓库根）
/pnpm-lock.yaml

# 环境变量
.env
.env.local
.env*.local

# 日志与系统文件
*.log
.DS_Store

# 平台目录
.vercel
.edgeone

# 校准用真实飞行日志（含 GPS 轨迹，勿入库；用小样本/合成日志做 CI）
tools/calibrate/logs/*.ulg
tools/calibrate/logs/*.bin

# TS 增量构建
*.tsbuildinfo

# Python 字节码
__pycache__/
*.pyc

# ruff 的缓存（配置见仓库根 pyproject.toml）
.ruff_cache/

.cache

# 站点内容的构建期拷贝（真源在 docs/guide、knowledge/skills、knowledge/mcp）
# 由 web/scripts/sync-content.mjs 在 dev / build 前现拷，不入库
web/.generated/