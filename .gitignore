# ========== 依赖 ==========
node_modules/
# pnpm workspace 的 lockfile 在仓库根（pnpm-workspace.yaml 在哪，lockfile 就在哪）——
# 它必须入库：CI / EdgeOne 部署都靠它做 frozen install。web/ 下那份是 workspace 化
# 之前的残留，已于 2026-09-26 删除（当时根 lockfile 被误标为「零依赖空壳」而漏提交，
# CI 的 --frozen-lockfile 找不到 lockfile 秒挂，Deploy 因此全 skipped，线上修不上去）。

# ========== 构建产物 ==========
.next/
out/
dist/
*.tsbuildinfo
# next-env.d.ts 是 Next 自己写的：dev 与 build 指向的类型目录不同（.next/dev/types ↔ .next/types），
# 交替跑一次就改一次内容。官方要求它不入库：nextjs.org/docs/app/api-reference/config/typescript
next-env.d.ts

# ========== Next.js / 站点 ==========
# 站点内容全部在 web/content/ 下，全部入库

# ========== Python ==========
# 字节码
__pycache__/
*.py[cod]
*.pyo
*.pyd
# 打包
*.egg-info/
# 工具缓存
.ruff_cache/
# 本地类型检查用的虚拟环境（pyright 靠它找到 numpy / pyulog；每台机器路径不同，不入库）
# 建法见 docs/develop/ 里的 pyright 一节：项目解释器 -m venv .venv，再装 numpy 与 pyulog
.venv/
# PX4 消息定义缓存（由 tools/dev/fetch_px4_uorb_msg.py 拉取，不入库）
.cache/
.pytest_cache/

# ========== 测试与覆盖率 ==========
.coverage
.coverage.*
htmlcov/
# Playwright
playwright-report/
test-results/

# ========== 环境变量 ==========
.env
.env.local
.env*.local

# ========== 平台部署 ==========
.vercel/
.edgeone/
.workbuddy/

