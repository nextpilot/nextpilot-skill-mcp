#!/usr/bin/env python
"""Pre-push hook: run the local fast checks.

  git push                    -> check_all.py --stage push          (seconds)
  WITH_E2E=1 git push         -> --stage push,ci --with-e2e
  FULL_PUSH=1 git push        -> --stage push,ci,build --with-e2e (everything CI does)

To bypass this hook: git push --no-verify

Why the checks are addressed by stage rather than by flags: checklist.yml owns
what each stage contains, so this hook only decides *when* to run one.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _venv_python import ensure_venv_python  # noqa: E402


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    script = str(root / "tools" / "ci" / "check_all.py")

    with_e2e = os.environ.get("WITH_E2E") == "1"
    if os.environ.get("FULL_PUSH") == "1":
        stages = ["push", "ci", "build"]
        with_e2e = True
    elif with_e2e:
        stages = ["push", "ci"]
    else:
        stages = ["push"]

    cmd = [sys.executable, script, "--stage", ",".join(stages)]
    # --with-e2e 与 stage 列表正交：它开关的是 ci stage *内部*的步骤。用
    # `"ci" not in stages` 推导会在所有需要它的场景里悄悄失效——E2E 步骤本就在
    # ci 里，想要它们的那次运行 stage 列表必然已含 ci。
    if with_e2e:
        cmd.append("--with-e2e")

    print(f"[pre-push] {Path(script).name} {' '.join(cmd[2:])}")
    return subprocess.run(cmd, cwd=str(root), check=False).returncode


if __name__ == "__main__":
    raise SystemExit(ensure_venv_python(main))
