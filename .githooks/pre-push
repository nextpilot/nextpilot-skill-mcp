#!/usr/bin/env python
"""Pre-push hook: sync artifacts then run the local fast checks (--push).

Step 1: run build:kb, stage generated artifacts, amend HEAD if they changed.
Step 2: run check_all.py --push (format/lint/type-check/guard/...).

If you need more switches, call check_all.py directly instead of through this hook.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _venv_python import ensure_venv_python  # noqa: E402

# 与 check_kb_fresh.py 同源；pathspec 语法见 gitignore(7)
ARTIFACT_PATHSPECS = ("*.generated.*", "web/content/guide/rule-*.mdx", "web/public/params")


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    web = root / "web"
    node = shutil.which("node") or "node"

    # ── Step 1: build:kb → stage artifacts → amend if changed ──────
    print("[pre-push] Running build:kb to sync artifacts...")
    build = subprocess.run(
        [node, "scripts/build-knowledge.mjs"],
        cwd=str(web),
        check=False,
    )
    if build.returncode != 0:
        print("[pre-push] build:kb failed -- fix the build error before pushing.")
        return 1

    subprocess.run(
        ["git", "add", "--", *ARTIFACT_PATHSPECS],
        cwd=str(root),
        check=False,
    )

    diff_cached = subprocess.run(
        ["git", "diff", "--cached", "--exit-code", "--", *ARTIFACT_PATHSPECS],
        cwd=str(root),
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if diff_cached.returncode != 0:
        amend = subprocess.run(
            ["git", "commit", "--amend", "--no-edit"],
            cwd=str(root),
            check=False,
        )
        if amend.returncode != 0:
            print("[pre-push] git commit --amend failed -- resolve manually then push again.")
            return 1
        print("[pre-push] Artifacts synced and amended into HEAD.")

    # ── Step 2: run the rest of the checks ─────────────────────────
    script = str(root / "tools" / "ci" / "check_all.py")
    cmd = [sys.executable, script, "--push"]
    print(f"[pre-push] {Path(script).name} --push")
    return subprocess.run(cmd, cwd=str(root), check=False).returncode


if __name__ == "__main__":
    raise SystemExit(ensure_venv_python(main))
