#!/bin/bash
# Pre-push hook — single entry through check_all.py
#   SKIP_E2E=1 git push          # check_all.py only, no E2E
#   SKIP_LOG_ANALYSIS=1 git push  # skip log-analysis smoke E2E

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "$SKIP_E2E" = "1" ]; then
  echo "===== SKIP_E2E=1: check_all.py only ====="
  cd "$REPO_ROOT"
  python tools/ci/check_all.py
  echo "===== OK ====="
  exit 0
fi

echo "===== pre-push check (check_all.py --with-e2e) ====="
cd "$REPO_ROOT"
python tools/ci/check_all.py --with-e2e