{
  "name": "nextpilot-skill-mcp",
  "private": true,
  "scripts": {
    "web:dev": "pnpm --filter ./web dev",
    "web:build": "pnpm --filter ./web build",
    "web:start": "pnpm --filter ./web start",
    "build:kb": "pnpm --filter ./web build:kb",
    "kb:watch": "pnpm --filter ./web kb:watch",
    "check:skills": "pnpm --filter ./web check:skills",
    "check:mcp": "pnpm --filter ./web check:mcp",
    "check:pre-commit": "python .githooks/pre-commit",
    "check:pre-push": "python .githooks/pre-push",
    "fix:links": "pnpm --filter ./web fix:links",
    "lint": "node node_modules/eslint/bin/eslint.js web && node node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs \"**/*.md\" \"**/*.mdx\"",
    "lint:py": "python -m ruff check .",
    "lint:all": "pnpm lint && pnpm lint:py && pnpm typecheck && pnpm typecheck:py",
    "format": "node node_modules/prettier/bin/prettier.cjs --write . && python -m ruff format .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check . && python -m ruff format --check .",
    "typecheck": "pnpm --filter ./web typecheck",
    "typecheck:py": "node node_modules/pyright/index.js knowledge/engine",
    "test": "pnpm --filter ./web test:e2e",
    "test:py": "python -m pytest knowledge/engine/tests",
    "ci:push": "python tools/ci/check_all.py --stage push"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.9.8",
    "pyright": "^1.1.400",
    "typescript": "^7.0.2"
  }
}
