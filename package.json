{
  "name": "nextpilot-skill-mcp",
  "private": true,
  "scripts": {
    "lint": "node node_modules/eslint/bin/eslint.js web && node node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs \"**/*.md\" \"**/*.mdx\"",
    "lint:py": "python -m ruff check .",
    "lint:all": "pnpm lint && pnpm lint:py && pnpm web:typecheck && pnpm typecheck:py",
    "format": "node node_modules/prettier/bin/prettier.cjs --write . && python -m ruff format .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check . && python -m ruff format --check .",
    "typecheck:py": "node node_modules/pyright/index.js knowledge/engine",
    "test:py": "python -m pytest knowledge/engine/tests",
    "web:dev": "pnpm --filter ./web dev",
    "web:build": "pnpm --filter ./web build",
    "web:start": "pnpm --filter ./web start",
    "web:build:kb": "pnpm --filter ./web build:kb",
    "web:kb:watch": "pnpm --filter ./web kb:watch",
    "web:check:skills": "pnpm --filter ./web check:skills",
    "web:check:mcp": "pnpm --filter ./web check:mcp",
    "web:fix:links": "pnpm --filter ./web fix:links",
    "web:typecheck": "pnpm --filter ./web typecheck",
    "web:test:e2e": "pnpm --filter ./web test:e2e",
    "hook:pre-commit": "python .githooks/pre-commit",
    "hook:pre-push": "python .githooks/pre-push",
    "ci:push": "python tools/ci/check_all.py --stage push"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "pyright": "^1.1.414",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/parser>typescript": "^6",
      "@typescript-eslint/eslint-plugin>typescript": "^6",
      "typescript-eslint>typescript": "^6"
    }
  }
}
