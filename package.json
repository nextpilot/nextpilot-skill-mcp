{
  "name": "nextpilot-skill-mcp",
  "private": true,
  "scripts": {
    "format:md": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.md\" \"**/*.mdx\"",
    "format:js": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,mjs,ts,tsx}\"",
    "format:py": "python -m ruff format .",
    "format": "pnpm format:md && pnpm format:py && pnpm format:js",
    "format:check:md": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.md\" \"**/*.mdx\"",
    "format:check:js": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,mjs,ts,tsx}\"",
    "format:check:py": "python -m ruff format --check .",
    "format:check": "pnpm format:check:md && pnpm format:check:py && pnpm format:check:js",
    "lint:md": "node node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs \"**/*.md\" \"**/*.mdx\"",
    "lint:js": "node node_modules/eslint/bin/eslint.js .",
    "lint:py": "python -m ruff check .",
    "lint": "pnpm lint:md && pnpm lint:js && pnpm lint:py",
    "typecheck:py": "node node_modules/pyright/index.js .",
    "typecheck:tsc": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "pnpm typecheck:tsc && pnpm typecheck:py",
    "lint:all": "pnpm format && pnpm lint && pnpm typecheck",
    "eng:test": "python -m pytest knowledge/engine/tests",
    "web:dev": "pnpm --filter ./web dev",
    "web:build": "pnpm --filter ./web build",
    "web:start": "pnpm --filter ./web start",
    "web:build:kb": "pnpm --filter ./web build:kb",
    "web:kb:watch": "pnpm --filter ./web kb:watch",
    "web:check:skills": "pnpm --filter ./web check:skills",
    "web:check:mcp": "pnpm --filter ./web check:mcp",
    "web:fix:links": "pnpm --filter ./web fix:links",
    "web:typecheck": "pnpm --filter ./web typecheck",
    "web:test:e2e": "pnpm --filter ./web test:e2e",
    "hook:pre-commit": "python .githooks/pre-commit",
    "hook:pre-push": "python .githooks/pre-push"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "pyright": "^1.1.414",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/parser>typescript": "^6",
      "@typescript-eslint/eslint-plugin>typescript": "^6",
      "typescript-eslint>typescript": "^6"
    }
  }
}